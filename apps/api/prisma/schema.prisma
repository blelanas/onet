// ONET Teboulba — data model
// SQLite / libSQL: a local file in development, Turso (hosted libSQL) in production.
// SQLite has no native enums: enum-like columns are strings validated by zod
// (see src/lib/constants.ts). Money is stored as integer millimes (1 TND = 1000 millimes).

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// The API connects through the libSQL driver adapter (local SQLite file or Turso).
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

// ───────────────────────────── Identity & access ─────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  avatarUrl    String?
  locale       String    @default("fr")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  roles         UserRole[]
  sessions      Session[]
  member        Member?
  notifications Notification[]
  auditLogs     AuditLog[]
  sentMessages  Message[]                 @relation("MessageSender")
  conversations ConversationParticipant[]
  announcements Announcement[]
  documents     Document[]
  payments      Payment[]                 @relation("PaymentRecorder")
  expenses      Expense[]
  attendance    Attendance[]              @relation("AttendanceRecorder")
  eventRegs     EventRegistration[]       @relation("EventRegisteredBy")
  tripRegs      TripRegistration[]        @relation("TripRegisteredBy")
  newsPosts     NewsPost[]
  activityReports ActivityReport[]
  calendarEntries CalendarEntry[]
  tasks         Task[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique // super_admin, admin, accountant, parent, kid, member, monitor
  name        String
  description String?
  color       String           @default("#6366f1")
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique // e.g. "members.read"
  module      String
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // create, update, delete, login, payment, permission_change...
  entity    String
  entityId  String?
  details   String? // JSON
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ───────────────────────────── People ─────────────────────────────

// A Member is any person known to the organization (child, parent, monitor, staff, member).
// A Member may optionally own a login (User).
model Member {
  id               String    @id @default(cuid())
  type             String // CHILD | PARENT | MONITOR | MEMBER | STAFF
  firstName        String
  lastName         String
  firstNameAr      String?
  lastNameAr       String?
  dateOfBirth      DateTime?
  gender           String? // M | F
  photoUrl         String?
  phone            String?
  email            String?
  address          String?
  city             String?   @default("Teboulba")
  emergencyName    String?
  emergencyPhone   String?
  membershipNumber String    @unique
  membershipStatus String    @default("ACTIVE") // ACTIVE | PENDING | INACTIVE | SUSPENDED
  membershipDate   DateTime  @default(now())
  notes            String?
  medicalNotes     String?
  points           Int       @default(0) // gamification for kids
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  groupId String?
  group   Group?  @relation("GroupChildren", fields: [groupId], references: [id], onDelete: SetNull)

  // Guardianship (parent ↔ child), many-to-many
  childrenLinks Guardianship[] @relation("GuardianParent")
  parentLinks   Guardianship[] @relation("GuardianChild")

  monitoredGroups     GroupMonitor[]
  ledActivities       Activity[]            @relation("ActivityMonitor")
  activityEnrollments ActivityParticipant[]
  attendance          Attendance[]
  eventRegistrations  EventRegistration[]
  tripRegistrations   TripRegistration[]
  tripMonitoring      TripMonitor[]
  invoicesAsPayer     Invoice[]             @relation("InvoicePayer")
  invoicesAsChild     Invoice[]             @relation("InvoiceChild")
  badges              MemberBadge[]

  @@index([type])
  @@index([groupId])
  @@index([lastName, firstName])
}

model Guardianship {
  parentId  String
  childId   String
  relation  String   @default("PARENT") // FATHER | MOTHER | GUARDIAN | PARENT
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  parent    Member   @relation("GuardianParent", fields: [parentId], references: [id], onDelete: Cascade)
  child     Member   @relation("GuardianChild", fields: [childId], references: [id], onDelete: Cascade)

  @@id([parentId, childId])
  @@index([childId])
}

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#E30613")
  icon        String   @default("star")
  ageMin      Int?
  ageMax      Int?
  capacity    Int      @default(20)
  schedule    String? // human-readable, e.g. "Samedi 10:00 – 12:00"
  meetingDay  Int? // 0=Sunday … 6=Saturday
  meetingTime String? // "10:00"
  location    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  children      Member[]       @relation("GroupChildren")
  monitors      GroupMonitor[]
  activities    Activity[]
  attendance    Attendance[]
  announcements Announcement[]
  tasks         Task[]
}

model GroupMonitor {
  groupId  String
  memberId String
  isLead   Boolean @default(false)
  group    Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member   Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([groupId, memberId])
}

model Badge {
  id          String        @id @default(cuid())
  key         String        @unique
  name        String
  description String?
  icon        String        @default("award")
  color       String        @default("#F9B000")
  points      Int           @default(10)
  members     MemberBadge[]
}

model MemberBadge {
  memberId  String
  badgeId   String
  awardedAt DateTime @default(now())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([memberId, badgeId])
}

// Public "Join us" requests, converted into Members by staff.
model JoinRequest {
  id          String    @id @default(cuid())
  parentName  String
  email       String
  phone       String
  childName   String?
  childDob    DateTime?
  message     String?
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt   DateTime  @default(now())
  processedAt DateTime?
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ───────────────────────────── Activities ─────────────────────────────

model Activity {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String // SPORTS | MUSIC | SONGS | EDUCATIONAL | GAMES | WORKSHOP | CULTURAL | CREATIVE | OUTDOOR
  coverUrl    String?
  ageMin      Int?
  ageMax      Int?
  durationMin Int      @default(60)
  location    String?
  materials   String?
  schedule    String? // human readable
  dayOfWeek   Int? // recurring weekly day 0..6
  startTime   String? // "14:00"
  startDate   DateTime?
  endDate     DateTime?
  capacity    Int      @default(25)
  status      String   @default("ACTIVE") // DRAFT | ACTIVE | COMPLETED | CANCELLED
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  monitorId String?
  monitor   Member? @relation("ActivityMonitor", fields: [monitorId], references: [id], onDelete: SetNull)
  groupId   String?
  group     Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  eventId   String?
  event     Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  participants ActivityParticipant[]
  attendance   Attendance[]
  invoices     Invoice[]
  reports      ActivityReport[]

  @@index([category])
  @@index([status])
}

model ActivityParticipant {
  activityId String
  memberId   String
  joinedAt   DateTime @default(now())
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([activityId, memberId])
}

model ActivityReport {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  date       DateTime
  summary    String
  createdAt  DateTime @default(now())
}

model Attendance {
  id           String   @id @default(cuid())
  date         DateTime // day (00:00 local)
  status       String // PRESENT | ABSENT | LATE | EXCUSED
  note         String?
  memberId     String
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  groupId      String?
  group        Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  activityId   String?
  activity     Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  eventId      String?
  event        Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  tripId       String?
  trip         Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  recordedById String?
  recordedBy   User?    @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // One record per member, per day, per context. `contextKey` = "group:<id>" | "activity:<id>" | ...
  contextKey String

  @@unique([memberId, date, contextKey])
  @@index([date])
}

// ───────────────────────────── Events & trips ─────────────────────────────

model Event {
  id                   String    @id @default(cuid())
  title                String
  description          String?
  category             String // CULTURAL | CHILDREN | COMPETITION | CELEBRATION | WORKSHOP | PUBLIC | MEETING
  coverUrl             String?
  startAt              DateTime
  endAt                DateTime
  location             String?
  capacity             Int       @default(100)
  organizer            String?
  registrationDeadline DateTime?
  price                Int       @default(0) // millimes
  requiresPayment      Boolean   @default(false)
  status               String    @default("PUBLISHED") // DRAFT | PUBLISHED | CANCELLED | COMPLETED
  isPublic             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  registrations EventRegistration[]
  activities    Activity[]
  attendance    Attendance[]
  invoices      Invoice[]
  expenses      Expense[]
  gallery       GalleryItem[]

  @@index([startAt])
}

model EventRegistration {
  id             String   @id @default(cuid())
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  registeredById String?
  registeredBy   User?    @relation("EventRegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)
  status         String   @default("CONFIRMED") // PENDING | CONFIRMED | WAITLIST | CANCELLED
  notes          String?
  invoiceId      String?  @unique
  invoice        Invoice? @relation("EventRegInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([eventId, memberId])
}

model Trip {
  id                   String    @id @default(cuid())
  title                String
  destination          String
  category             String // EDUCATIONAL | CAMPING | CULTURAL | OUTDOOR | EXCURSION | REGIONAL
  description          String?
  program              String? // one step per line: "08:00 | Départ"
  coverUrl             String?
  departureLocation    String
  departAt             DateTime
  returnAt             DateTime
  capacity             Int       @default(40)
  price                Int       @default(0) // millimes
  requiredDocuments    String? // one per line
  registrationDeadline DateTime?
  ageMin               Int?
  ageMax               Int?
  status               String    @default("OPEN") // DRAFT | OPEN | FULL | CLOSED | COMPLETED | CANCELLED
  isPublic             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  monitors      TripMonitor[]
  registrations TripRegistration[]
  attendance    Attendance[]
  invoices      Invoice[]
  expenses      Expense[]
  gallery       GalleryItem[]

  @@index([departAt])
}

model TripMonitor {
  tripId   String
  memberId String
  trip     Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([tripId, memberId])
}

model TripRegistration {
  id              String   @id @default(cuid())
  tripId          String
  trip            Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  memberId        String
  member          Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  registeredById  String?
  registeredBy    User?    @relation("TripRegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)
  status          String   @default("PENDING") // PENDING | CONFIRMED | WAITLIST | CANCELLED
  parentConsent   Boolean  @default(false)
  documentsStatus String   @default("MISSING") // MISSING | PARTIAL | COMPLETE
  notes           String?
  invoiceId       String?  @unique
  invoice         Invoice? @relation("TripRegInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tripId, memberId])
}

// ───────────────────────────── Content ─────────────────────────────

model Song {
  id          String   @id @default(cuid())
  title       String
  lyrics      String
  audioUrl    String?
  coverUrl    String?
  category    String // ANTHEM | CHILDREN | EDUCATIONAL | FOLK | CAMP | CELEBRATION
  ageGroup    String   @default("ALL") // 4-7 | 8-12 | 13-17 | ALL
  author      String?
  language    String   @default("ar")
  tags        String? // comma separated
  durationSec Int?
  featured    Boolean  @default(false)
  isPublic    Boolean  @default(true)
  plays       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Game {
  id           String   @id @default(cuid())
  name         String
  description  String
  rules        String?
  instructions String?
  category     String // OUTDOOR | INDOOR | TEAM | EDUCATIONAL | ICEBREAKER | ENERGIZER
  ageGroup     String   @default("ALL")
  minPlayers   Int      @default(2)
  maxPlayers   Int?
  durationMin  Int      @default(15)
  materials    String?
  imageUrl     String?
  videoUrl     String?
  isPublic     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Conference {
  id          String   @id @default(cuid())
  title       String
  speaker     String
  speakerBio  String?
  description String?
  category    String // EDUCATION | HEALTH | PARENTING | CHILD_RIGHTS | ENVIRONMENT | CULTURE | TECHNOLOGY
  date        DateTime
  location    String?
  coverUrl    String?
  mediaUrl    String? // audio/video
  mediaType   String? // AUDIO | VIDEO
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Resource {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String // PDF | IMAGE | VIDEO | DOCUMENT | LINK
  url         String
  category    String?
  audience    String   @default("ALL") // ALL | PARENTS | MONITORS | KIDS
  sizeBytes   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NewsPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  body        String
  coverUrl    String?
  category    String    @default("NEWS")
  isPublished Boolean   @default(true)
  publishedAt DateTime  @default(now())
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model GalleryItem {
  id        String   @id @default(cuid())
  imageUrl  String
  caption   String?
  album     String   @default("GENERAL")
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  tripId    String?
  trip      Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ───────────────────────────── Finance ─────────────────────────────

model Invoice {
  id          String    @id @default(cuid())
  number      String    @unique // ONET-2026-0001
  description String
  amount      Int // millimes
  currency    String    @default("TND")
  status      String    @default("PENDING") // DRAFT | PENDING | PARTIALLY_PAID | PAID | CANCELLED | OVERDUE
  issuedAt    DateTime  @default(now())
  dueDate     DateTime
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  payerId    String
  payer      Member    @relation("InvoicePayer", fields: [payerId], references: [id], onDelete: Restrict)
  childId    String?
  child      Member?   @relation("InvoiceChild", fields: [childId], references: [id], onDelete: SetNull)
  eventId    String?
  event      Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  tripId     String?
  trip       Trip?     @relation(fields: [tripId], references: [id], onDelete: SetNull)
  activityId String?
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  payments         Payment[]
  eventRegistration EventRegistration? @relation("EventRegInvoice")
  tripRegistration  TripRegistration?  @relation("TripRegInvoice")

  @@index([status])
  @@index([payerId])
}

model Payment {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount       Int // millimes
  method       String // CASH | BANK_TRANSFER | ONLINE | CHECK | OTHER
  status       String   @default("COMPLETED") // PENDING | COMPLETED | FAILED | REFUNDED
  reference    String?
  provider     String? // e.g. "manual", "mock", "konnect", "flouci", "clictopay"
  providerRef  String?
  paidAt       DateTime @default(now())
  notes        String?
  recordedById String?
  recordedBy   User?    @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([paidAt])
}

model Expense {
  id            String   @id @default(cuid())
  category      String // TRANSPORT | FOOD | MATERIALS | ACCOMMODATION | RENT | UTILITIES | EQUIPMENT | COMMUNICATION | OTHER
  amount        Int // millimes
  date          DateTime
  description   String
  supplier      String?
  attachmentUrl String?
  eventId       String?
  event         Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  tripId        String?
  trip          Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([date])
}

// ───────────────────────────── Communication ─────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // EVENT_NEW | TRIP_REGISTRATION | PAYMENT_REMINDER | PAYMENT_CONFIRMED | ACTIVITY | EVENT_REMINDER | ATTENDANCE | MESSAGE | ANNOUNCEMENT | SYSTEM
  title     String
  body      String?
  link      String?
  channel   String    @default("IN_APP") // IN_APP | EMAIL | SMS | PUSH
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  audience    String    @default("ALL") // ALL | PARENTS | MONITORS | KIDS | STAFF | GROUP
  groupId     String?
  group       Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  priority    String    @default("NORMAL") // NORMAL | IMPORTANT | URGENT
  isPinned    Boolean   @default(false)
  publishedAt DateTime  @default(now())
  expiresAt   DateTime?
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Conversation {
  id           String                    @id @default(cuid())
  subject      String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  conversationId String
  userId         String
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// Polymorphic attachment: entityType ∈ MEMBER | EVENT | TRIP | INVOICE | ACTIVITY | GENERAL
model Document {
  id           String   @id @default(cuid())
  name         String
  url          String
  mimeType     String
  sizeBytes    Int
  category     String   @default("OTHER") // MEDICAL | ID | AUTHORIZATION | INVOICE | REPORT | PHOTO | OTHER
  entityType   String   @default("GENERAL")
  entityId     String?
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
}

// Free calendar entries (meetings, holidays, important dates). Activities/events/trips/
// conferences are projected onto the calendar from their own tables.
model CalendarEntry {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String   @default("MEETING") // MEETING | HOLIDAY | IMPORTANT | OTHER
  startAt     DateTime
  endAt       DateTime?
  allDay      Boolean  @default(false)
  location    String?
  audience    String   @default("ALL")
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  status      String    @default("TODO") // TODO | IN_PROGRESS | DONE
  assigneeId  String?
  assignee    User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  groupId     String?
  group       Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
}

model Setting {
  key       String   @id
  value     String // JSON
  updatedAt DateTime @updatedAt
}

// ───────────────────────────── File storage ─────────────────────────────
// Uploaded files live in the database (the free API host has no persistent disk).
// Content is split into chunks to stay well below per-row size limits. URLs: /api/files/<id>.
model StoredFile {
  id           String            @id // random, unguessable
  name         String
  mimeType     String
  sizeBytes    Int
  uploadedById String?
  createdAt    DateTime          @default(now())
  chunks       StoredFileChunk[]
}

model StoredFileChunk {
  fileId String
  index  Int
  data   Bytes
  file   StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([fileId, index])
}
