# ── API (apps/api) ─────────────────────────────────────────────
# Local development: a SQLite file. Production: your Turso database.
DATABASE_URL=file:./prisma/dev.db
# DATABASE_URL=libsql://onet-teboulba-<org>.turso.io
# DATABASE_AUTH_TOKEN=<turso db tokens create onet-teboulba>
PORT=4000
CORS_ORIGINS=http://localhost:5173
PAYMENT_PROVIDER=mock

# ── Web (apps/web) — build-time variable ──────────────────────
VITE_API_URL=http://localhost:4000
