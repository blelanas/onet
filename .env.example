# ── API (apps/api) ─────────────────────────────────────────────
# Local development: a SQLite file. Production: your Turso database.
DATABASE_URL=file:./prisma/dev.db
# DATABASE_URL=libsql://onet-teboulba-<org>.turso.io
# DATABASE_AUTH_TOKEN=<turso db tokens create onet-teboulba>
PORT=4000
CORS_ORIGINS=http://localhost:5173
PAYMENT_PROVIDER=mock
# Optional "Continue with Google" (docs/DEPLOYMENT.md): OAuth client id, not a secret. Empty = disabled.
GOOGLE_CLIENT_ID=

# ── Web (apps/web) — build-time variables ─────────────────────
VITE_API_URL=http://localhost:4000
# Same value as GOOGLE_CLIENT_ID; empty = the Google button is hidden.
VITE_GOOGLE_CLIENT_ID=
